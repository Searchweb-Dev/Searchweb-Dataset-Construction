# 환경 변수 예시

# 데이터베이스
POSTGRES_PASSWORD=your-postgres-password-here
DATABASE_URL=postgresql://ai_detector:your-postgres-password-here@localhost:5432/ai_detector

# Redis
REDIS_URL=redis://localhost:6379/0

# 분류기 모드: llm (기본) | rule
CLASSIFIER_MODE=llm

# LLM 프로바이더 설정 (현재: gemini만 구현)
LLM_PROVIDER=gemini

# Gemini API (무료 발급: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini 모델 선택 (기본값: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# API 설정
API_KEY=your-api-key-here
ENV=development

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 로그 레벨 (DEBUG | INFO | WARNING | ERROR, 기본값: INFO)
LOG_LEVEL=INFO

# 배치 분석 병렬 동시 실행 수 (LLM API rate limit 고려, 기본값: 5)
BATCH_CONCURRENCY=5

# DB 커넥션 풀 설정 (기본값으로 대부분의 환경에서 충분)
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# 접근 불가 URL 재분석 대기 기간 (일, 기본값: 7)
# UNREACHABLE_TTL_DAYS=7

# Celery 워커 설정
# CELERY_MAX_TASKS_PER_CHILD=1000

# Gemini API 재시도 정책 (기본값으로 대부분의 환경에서 충분)
# GEMINI_RETRY_MULTIPLIER=1
# GEMINI_RETRY_MIN_WAIT=2
# GEMINI_RETRY_MAX_WAIT=30
# GEMINI_RETRY_ATTEMPTS=2
